##
## The alerts page: one card per active alert, with a severity-colored
## rail, a status badge, a window bar showing where now falls between onset
## and end, the description's sections as real structure, instructions
## called out, and one gray footer line.  The quiet state -- which is most
## days, most places -- is a calm all-clear naming the area and when.
##
## The card itself is $nwsskin.card(); the CAP semantics it leans on
## (ordering, the open-ended window, the description parser, headline case)
## are $nwsforecast tags, because those are facts about the feed rather
## than this report's taste.
##
## Nothing time-relative is baked ONLY: each card carries its instants as
## data attributes and scripts/nws.js rewrites the badge, the note and the
## bar every minute, so a tab left open does not go stale.  The page itself
## never reloads and fetches nothing.
#errorCatcher Echo
#encoding UTF-8
#import time
## Lowercased am/pm to match \$nwsskin.hm(), which every other time on
## these pages goes through -- otherwise the heading reads "2:33 PM"
## directly above a card reading "1:33 pm".
#set $checked = time.strftime('%A %-I:%M %p').replace('AM', 'am').replace('PM', 'pm')
#set $ordered = $nwsforecast.ordered($nwsforecast.alerts())
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NWS Alerts</title>
    <meta name="description" content="Active National Weather Service watches, warnings and advisories for $station.location.">
    <link rel="stylesheet" type="text/css" href="css/nws.css">
    <script src="scripts/nws.js"></script>
  </head>
  <body>
#set global $selection = "alerts"
#include "menubar.inc"
    <div class="fc">
      <div class="fcwrap">

        <div class="chead">
          <h1 class="ctitle"><span class="over">NWS</span> Alerts</h1>
          <div class="sub">$station.location &middot; checked $checked</div>
        </div>

#if $ordered
        <section class="acount">
          <h2 class="eyebrow">For this area</h2>
          <p class="acountline">$nwsskin.count_line($ordered)</p>
        </section>
#for $a in $ordered
$nwsskin.card($a)
#end for
#else
        <section class="allclear">
          <svg class="tick" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="11"/><path d="M6.5 12.4l3.6 3.6 7.4-7.8"/></svg>
          <div>
            <h2 class="acname">No alerts in effect</h2>
            <p class="acbody">The National Weather Service has no watches, warnings or
            advisories out for $station.location.  This page was generated $checked.</p>
          </div>
        </section>
#end if

        <div class="cfoot">National Weather Service &middot; checked $checked</div>

      </div>
    </div>
  </body>
</html>
