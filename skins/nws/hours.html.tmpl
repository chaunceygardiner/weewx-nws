##
## The hourly page: NWS's one-hour periods as a next-twelve-hours strip,
## then one tab per CALENDAR DAY carrying that day's chart AND its hour
## table, then the whole week as one curve at the bottom.
##
## Day grouping is a $nwsforecast tag; chart geometry and the 15% rain
## threshold are $nwsskin; the icons are $nwsforecast's drawn set.
## scripts/nws.js binds the tabs and the crosshair -- with javascript off
## the first day still shows and every chart is still drawn.
#errorCatcher Echo
#encoding UTF-8
#import time
## One fetch feeds the strip, every tab and the week curve.
#set $records = $nwsforecast.one_hour_forecasts()
#set $hours = $nwsforecast.points($records)
#set $tabs = $nwsforecast.hour_days($records)
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NWS Hourly Forecast</title>
    <meta name="description" content="National Weather Service hour-by-hour forecast for $station.location.">
    <link rel="stylesheet" type="text/css" href="css/nws.css">
    <script src="scripts/nws.js"></script>
  </head>
  <body>
    $nwsforecast.icon_sprite
#set global $selection = "hours"
#include "menubar.inc"
    <div class="fc">
      <div class="fcwrap">

        <div class="chead">
          <h1 class="ctitle"><span class="over">NWS</span> Hourly Forecast</h1>
          <div class="sub">$station.location
#if $records
            &middot; issued $nwsskin.hm($records[0].generatedTime, '%A %-I:%M %p')
#end if
          </div>
        </div>

#if $records
        <section class="next12">
          <h2 class="eyebrow">Next 12 hours</h2>
          <div class="hcards">
#for $h in $records[0:12]
            <div class="hcard">
              <div class="ht">$nwsskin.hm($h.startTime, '%-I %p')</div>
              $nwsforecast.icon($h.iconUrl)
              <div class="htemp">$nwsskin.num_cell($h.outTemp)</div>
              <div class="hpop">$nwsskin.pop_cell($h)</div>
            </div>
#end for
          </div>
        </section>
#end if

        <section class="everyhour">
          <h2 class="eyebrow">Every hour</h2>
          <div class="daytabs">
#for $i, $t in enumerate($tabs)
#if $i == 0
#set $tab_class = 'daytab on'
#else
#set $tab_class = 'daytab'
#end if
            <button type="button" class="$tab_class" data-day="$t.key"><span class="dt1">$t.label</span><span class="dt2">$t.datestr</span></button>
#end for
          </div>
#for $i, $t in enumerate($tabs)
#if $i == 0
#set $pane_class = 'daypane'
#else
#set $pane_class = 'daypane off'
#end if
#set $noon = time.mktime(($t.date.year, $t.date.month, $t.date.day, 12, 0, 0, 0, 0, -1))
#set $alm = $almanac(almanac_time=$noon)
## hour_days() groups; the plain numbers a chart needs are a separate tag.
#set $pts = $nwsforecast.points($t.rows)
          <div class="$pane_class" data-day="$t.key">
            <div class="daysun">daylight $nwsskin.hm($alm.sunrise) to $nwsskin.hm($alm.sunset) &middot; $len($t.rows) hours forecast</div>
            ## The chart belongs to the tab, so it redraws with it.  The last
            ## day of the feed can be a single hour, which is not a curve.
#if $len($pts) > 1
            <div class="chartwrap">$nwsskin.day_chart($pts)<div class="readout" hidden></div></div>
            $nwsskin.LEGEND
#end if
            ## No heading over the chance of rain -- see index.html.tmpl.
            <div class="hhead"><div>Hour</div><div></div><div></div>
              <div>Forecast</div><div class="chr">Temp</div>
              <div class="chr">Dew pt</div><div class="chr">Humid</div>
              <div class="chr">Wind</div></div>
#for $h in $t.rows
#if $h.isDaytime
#set $row_class = 'hrow'
#else
#set $row_class = 'hrow nightrow'
#end if
            <div class="$row_class">
              <div class="hr-t">$nwsskin.hm($h.startTime, '%-I %p')</div>
              <div class="hr-i">$nwsforecast.icon($h.iconUrl)</div>
              ## Beside the icon, as on the seven-day rows.
              <div class="hr-n hr-pop">$nwsskin.pop_cell($h)</div>
              <div class="hr-f">$nwsskin.esc($h.shortForecast)</div>
              <div class="hr-n">$nwsskin.num_cell($h.outTemp)</div>
              <div class="hr-n dim">$nwsskin.num_cell($h.dewpoint)</div>
              <div class="hr-n dim">$nwsskin.num_cell($h.outHumidity, '%')</div>
              <div class="hr-w">$nwsskin.wind_cell($h, $unit.label.windSpeed)</div>
            </div>
#end for
          </div>
#end for
#if $tabs
          <p class="caption">One day at a time &mdash; the chart and the table both
          follow the tab.  The <b>droplet</b> beside an hour is its chance of rain; no
          droplet means under 15%, weather.gov&rsquo;s own threshold, and the charts
          still draw every hour&rsquo;s chance in full.  At 24 points an hour label fits
          under every third hour and the gap between temperature and dew point is
          readable; that gap closing is the fog the forecast text keeps mentioning.
          Point at a chart &mdash; or drag a finger across it &mdash; to read any
          hour.</p>
#else
          <p class="caption">No hourly forecast is available.  The National Weather
          Service feed has not been read yet, or the last several polls failed.</p>
#end if
        </section>

#if $len($hours) > 1
        <section class="curve">
          <h2 class="eyebrow">The whole week</h2>
          $nwsskin.LEGEND
          <div class="chartwrap">$nwsskin.week_chart($hours)<div class="readout" hidden></div></div>
          <p class="caption">All $len($hours) hours the National Weather Service
          forecasts, for the trend rather than the detail &mdash; squeezed this far the
          shape of any one day is not readable, which is what the day charts above are
          for.</p>
        </section>
#end if

        <div class="cfoot">National Weather Service
#if $records
          &middot; hourly forecast issued $nwsskin.hm($records[0].generatedTime, '%A %-I:%M %p')
#end if
        </div>

      </div>
    </div>
  </body>
</html>
